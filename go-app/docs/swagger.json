{
    "swagger": "2.0",
    "info": {
        "description": "API for the incident grievance ledger",
        "title": "Ledger-Grievance API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8000",
    "basePath": "/",
    "paths": {
        "/incidents": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "incidents"
                ],
                "summary": "List incidents",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Reporter ID",
                        "name": "reporter_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Status",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Category",
                        "name": "category",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Search query",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Limit",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Offset",
                        "name": "offset",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.ListResult"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            },
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "incidents"
                ],
                "summary": "Create a new incident",
                "parameters": [
                    {
                        "description": "Incident request",
                        "name": "incident",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/domain.IncidentCreate"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/domain.Incident"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "418": {
                        "description": "I'm a teapot",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.Incident": {
            "description": "Incident model",
            "type": "object",
            "properties": {
                "category": {
                    "type": "string",
                    "example": "technical"
                },
                "description": {
                    "type": "string",
                    "example": "the system crashed"
                },
                "evidence_uri": {
                    "type": "string",
                    "example": "https://example.com/log"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "notes": {
                    "type": "string",
                    "example": "investigating"
                },
                "occurred_at": {
                    "type": "string"
                },
                "original_hash": {
                    "type": "string",
                    "example": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
                },
                "recorded_at": {
                    "type": "string"
                },
                "reporter_id": {
                    "type": "string",
                    "example": "jordan"
                },
                "requires_accommodation": {
                    "type": "boolean",
                    "example": false
                },
                "severity": {
                    "type": "integer",
                    "example": 3
                },
                "status": {
                    "allOf": [
                        {
                            "$ref": "#/definitions/domain.Status"
                        }
                    ],
                    "example": "reported"
                },
                "subject": {
                    "type": "string",
                    "example": "system failure"
                },
                "was_forgotten": {
                    "type": "boolean",
                    "example": false
                }
            }
        },
        "domain.IncidentCreate": {
            "description": "Incident creation request",
            "type": "object",
            "required": [
                "assumed_good_intentions",
                "description",
                "promised_to_be_kind_to_yourself",
                "reporter_id",
                "subject"
            ],
            "properties": {
                "assumed_good_intentions": {
                    "type": "boolean",
                    "example": true
                },
                "category": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1,
                    "example": "technical"
                },
                "description": {
                    "type": "string",
                    "minLength": 1,
                    "example": "the system crashed"
                },
                "evidence_uri": {
                    "type": "string",
                    "example": "https://example.com/log"
                },
                "notes": {
                    "type": "string",
                    "example": "investigating"
                },
                "occurred_at": {
                    "type": "string"
                },
                "promised_to_be_kind_to_yourself": {
                    "type": "boolean",
                    "example": true
                },
                "reporter_id": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1,
                    "example": "jordan"
                },
                "requires_accommodation": {
                    "type": "boolean",
                    "example": false
                },
                "severity": {
                    "type": "integer",
                    "maximum": 5,
                    "minimum": 1,
                    "example": 3
                },
                "subject": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 1,
                    "example": "system failure"
                }
            }
        },
        "domain.ListResult": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/domain.Incident"
                    }
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "domain.Status": {
            "type": "string",
            "enum": [
                "reported",
                "reviewing",
                "resolved",
                "dismissed",
                "archived",
                "celebrated"
            ],
            "x-enum-varnames": [
                "StatusReported",
                "StatusReviewing",
                "StatusResolved",
                "StatusDismissed",
                "StatusArchived",
                "StatusCelebrated"
            ]
        }
    }
}